{
  "id": "agent_chat",
  "main": "./dist/index.js",
  "channels": [
    "agent_chat"
  ],
  "channelConfigs": {
    "agent_chat": {
      "schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "database": {
            "type": "string",
            "description": "PostgreSQL database name"
          },
          "host": {
            "type": "string",
            "description": "PostgreSQL host"
          },
          "port": {
            "type": "integer",
            "description": "PostgreSQL port"
          },
          "user": {
            "type": "string",
            "description": "PostgreSQL user"
          },
          "password": {
            "type": "string",
            "description": "PostgreSQL password"
          },
          "pollIntervalMs": {
            "type": "integer",
            "description": "Keep-alive poll interval in ms"
          },
          "agentId": {
            "type": "string",
            "description": "OpenClaw gateway agent id that owns agent_chat sessions (overrides sole/default agent resolution)"
          }
        }
      }
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "database": {
        "type": "string",
        "description": "PostgreSQL database name"
      },
      "host": {
        "type": "string",
        "description": "PostgreSQL host"
      },
      "port": {
        "type": "integer",
        "description": "PostgreSQL port"
      },
      "user": {
        "type": "string",
        "description": "PostgreSQL user"
      },
      "password": {
        "type": "string",
        "description": "PostgreSQL password"
      },
      "pollIntervalMs": {
        "type": "integer",
        "description": "Keep-alive poll interval in ms"
      },
      "agentId": {
        "type": "string",
        "description": "OpenClaw gateway agent id that owns agent_chat sessions (overrides sole/default agent resolution)"
      }
    }
  },
  "contracts": {
    "tools": [
      "agent_chat_send",
      "agent_chat_mark",
      "agent_chat_mute"
    ]
  }
}
