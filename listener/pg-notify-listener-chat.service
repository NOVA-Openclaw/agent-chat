[Unit]
Description=PostgreSQL schema-sync listener for agent_chat (%u)
After=network.target postgresql.service
# Restart=on-failure handles process crashes, but it does NOT cover the
# alive-but-deaf failure mode that can occur after a PostgreSQL restart
# (the process stays up but its LISTEN connection is dead). The in-process
# reconnect loop in pg-notify-listener-chat.py detects closed connections
# and re-issues LISTEN, so that case is handled without relying on systemd.

[Service]
Type=simple
ExecStart=%h/.local/share/%u/venv/bin/python %h/.openclaw/scripts/pg-notify-listener-chat.py
WorkingDirectory=%h/.openclaw/scripts
StandardOutput=append:%h/.openclaw/logs/pg-notify-listener-chat.log
StandardError=append:%h/.openclaw/logs/pg-notify-listener-chat.log
Restart=on-failure
RestartSec=5
Environment="AGENT_CHAT_REPO=%h/agent-chat"

[Install]
WantedBy=default.target
